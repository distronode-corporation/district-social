{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // No source maps in the package: they would point at ../src/*.ts, which is not in it.
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
